{
  "name": "avti-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Avti terminal AI agent for local projects",
  "license": "MIT",
  "type": "module",
  "bin": {
    "avti": "lib/avti.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "yarn run build && yarn run typecheck && node lib/avti.js --version",
    "dist:win": "yarn run build && node scripts/package-windows.mjs",
    "dist:mac": "yarn run build && node scripts/package-macos.mjs"
  },
