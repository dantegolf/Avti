{
  "name": "avti-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Avti terminal AI agent for local projects",
  "license": "MIT",
  "type": "module",
  "bin": {
    "avti": "lib/avti.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "yarn run build && yarn run typecheck && node lib/avti.js --version",
    "dist:win": "yarn run build && yarn workspaces focus avti-cli --production && node scripts/package-windows.mjs",
    "dist:mac": "yarn run build && yarn workspaces focus avti-cli --production && node scripts/package-macos.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.7",
    "@deepseek-ai/dsh-app-boot": "0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-query": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  }
}
